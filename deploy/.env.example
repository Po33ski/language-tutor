# Copy to deploy/.env on the server and fill in. Never commit the real file.

# Public hostname of the API; Caddy gets an HTTPS certificate for it.
# Free option without buying a domain: <your-ip-with-dashes>.sslip.io, e.g. 141-147-1-2.sslip.io
API_DOMAIN=

# Anthropic API key from https://console.anthropic.com (set a spend limit there too)
ANTHROPIC_API_KEY=

# Signup is open to anyone, so cap what one account and the whole app can spend per day
# (UTC days, 0 = unlimited), and how many accounts one network can create per hour.
USER_DAILY_TUTOR_TURNS=200
DAILY_TUTOR_TURNS_TOTAL=2000
USER_DAILY_TRANSCRIPTIONS=200
SIGNUPS_PER_IP_PER_HOUR=5

# The Vercel frontend URL(s), as a JSON list
CORS_ORIGINS=["https://your-app.vercel.app"]

# Requests per minute per client to LLM and speech endpoints (0 = unlimited)
RATE_LIMIT_PER_MINUTE=30

LLM_MODEL=anthropic:claude-haiku-5-5
TUTOR_EFFORT=low
SUMMARY_EFFORT=medium
STALE_LESSON_HOURS=6

SPEECH_ENABLED=true
# Speech to text through Groq's hosted Whisper (≈ 1 s; free tier is plenty for a few users).
# Key from https://console.groq.com/keys. Without a key, local Whisper is used.
STT_PROVIDER=groq
GROQ_API_KEY=
# Local Whisper on the CPU, the fallback when Groq fails: "small" takes a few seconds on
# 4 ARM cores; "large-v3-turbo" is more accurate but several times slower.
WHISPER_MODEL=small
TTS_VOICE=af_heart
