# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# LangChain model id in "provider:model" format
LLM_MODEL=anthropic:claude-haiku-5-5
# Reasoning effort for tutor replies: low | medium | high
TUTOR_EFFORT=low
# Reasoning effort for lesson summaries: low | medium | high
SUMMARY_EFFORT=medium
# Active lessons idle for longer than this are summarized automatically at startup
STALE_LESSON_HOURS=6
# Accounts: sessions end after this many idle days, and after the maximum in any case
SESSION_IDLE_DAYS=30
SESSION_MAX_DAYS=90
# Reject passwords known from data breaches (Have I Been Pwned, k-anonymity)
PASSWORD_BREACH_CHECK=true
# Signup is open: daily cost limits (UTC days, 0 = unlimited) and new accounts per IP per hour
USER_DAILY_TUTOR_TURNS=200
DAILY_TUTOR_TURNS_TOTAL=2000
USER_DAILY_TRANSCRIPTIONS=200
SIGNUPS_PER_IP_PER_HOUR=5
# Requests per minute per client to LLM and speech endpoints (0 = unlimited)
RATE_LIMIT_PER_MINUTE=30
# Local speech models (downloaded from Hugging Face on first run)
SPEECH_ENABLED=true
# Speech to text: local (Whisper in this process) or groq (hosted Whisper, falls back to local)
STT_PROVIDER=local
# Groq API key from https://console.groq.com/keys (only for STT_PROVIDER=groq)
GROQ_API_KEY=
GROQ_STT_MODEL=whisper-large-v3-turbo
WHISPER_MODEL=large-v3-turbo
# auto | cuda | cpu
WHISPER_DEVICE=auto
# Kokoro voice; first letter = accent (a = American, b = British), e.g. bf_emma
TTS_VOICE=af_heart
