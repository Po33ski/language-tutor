# Anthropic API key from https://console.anthropic.com
ANTHROPIC_API_KEY=
# LangChain model id in "provider:model" format
LLM_MODEL=anthropic:claude-haiku-5-5
# Reasoning effort for tutor replies: low | medium | high
TUTOR_EFFORT=low
# Reasoning effort for lesson summaries: low | medium | high
SUMMARY_EFFORT=medium
# Active lessons idle for longer than this are summarized automatically at startup
STALE_LESSON_HOURS=6
